{
  "expo": {
    "name": "vibesphere-app",
    "slug": "vibesphere-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vibesphereapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for video calls, photos, and reels.",
        "NSMicrophoneUsageDescription": "Microphone is used for voice calls, video calls, and audio.",
        "NSPhotoLibraryUsageDescription": "Allow access to photos to share images and media.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving photos and videos to your device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anupdixit.vibesphereapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is used for video calls, photos, and reels.",
          "microphonePermission": "Microphone is used for voice calls, video calls, and audio."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to share images and media."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to media library to save or pick media.",
          "savePhotosPermission": "Allow saving photos and videos to your device."
        }
      ],
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-image",
      "expo-audio",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6a86e3a7-d895-4b70-8d39-68faa3b88084"
      }
    },
    "owner": "anupdixit1"
  }
}
